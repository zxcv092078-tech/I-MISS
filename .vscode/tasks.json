{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动后端",
      "type": "shell",
      "command": "uvicorn server:app --host 0.0.0.0 --port 8000 --reload",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "run" }
    },
    {
      "label": "启动App(Expo)",
      "type": "shell",
      "command": "npx expo start",
      "options": { "cwd": "${workspaceFolder}/app" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "run" }
    }
  ]
}
